+import { describe, expect, it } from 'vitest';
+import { extractSubdomain } from '../../middleware';
+
+describe('41', () => {
+  it('extractSubdomain resolves a local dev subdomain', () => {
+    expect(extractSubdomain('demo.localhost:3000')).toBe('demo');
+    expect(extractSubdomain('idea-vibes.localhost:3000')).toBe('idea-vibes');
+  });
+
+  it('extractSubdomain ignores www on localhost', () => {
+    expect(extractSubdomain('www.localhost:3000')).toBeNull();
+  });
+
+  it('extractSubdomain returns null for bare localhost / loopback', () => {
+    expect(extractSubdomain('localhost:3000')).toBeNull();
+    expect(extractSubdomain('127.0.0.1:3000')).toBeNull();
+  });
+
+  it('extractSubdomain resolves a production wildcard-DNS subdomain', () => {
+    expect(extractSubdomain('demo.example.com')).toBe('demo');
+    expect(extractSubdomain('acme-corp.example.com')).toBe('acme-corp');
+  });
+
+  it('extractSubdomain ignores www and apex domains in production', () => {
+    expect(extractSubdomain('www.example.com')).toBeNull();
+    expect(extractSubdomain('example.com')).toBeNull();
+  });
+
+  it('extractSubdomain does not treat Vercel/Netlify preview hosts as tenants', () => {
+    expect(extractSubdomain('luxgen-web-git-main-team.vercel.app')).toBeNull();
+    expect(extractSubdomain('some-deploy-id--luxgen.netlify.app')).toBeNull();
+  });
+});
