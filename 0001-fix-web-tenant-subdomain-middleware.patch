 import { NextRequest, NextResponse } from 'next/server';
 
+// Platform hosting domains whose subdomain is a deployment identifier
+// (e.g. Vercel preview URLs), never a tenant — must not be treated as a tenant subdomain.
+const PLATFORM_HOSTS = ['vercel.app', 'netlify.app'];
+
+/**
+ * Resolve the tenant subdomain from a request hostname.
+ *
+ * Mirrors `extractSubdomain`/`extractCustomDomain` in
+ * `apps/api/src/middleware/tenantRouting.ts` so the web and API apps agree on
+ * tenant resolution once deployed behind a real domain (see
+ * docs/deployment/FREE_TIER_CLOUD.md, Step 7 — wildcard DNS -> Vercel).
+ *
+ * - `demo.localhost:3000` (local dev) -> `demo`
+ * - `demo.example.com` (production, wildcard DNS) -> `demo`
+ * - `luxgen-web-git-main-team.vercel.app` (Vercel preview) -> `null` (not a tenant)
+ * - `example.com` / `www.example.com` (apex/no tenant) -> `null`
+ */
+export function extractSubdomain(hostname: string): string | null {
+  const clean = hostname.split(':')[0];
+
+  if (clean === 'localhost' || clean.startsWith('127.0.0.1')) {
+    return null;
+  }
+
+  if (clean.endsWith('.localhost')) {
+    const parts = clean.split('.');
+    return parts.length >= 2 && parts[0] !== 'www' ? parts[0] : null;
+  }
+
+  if (PLATFORM_HOSTS.some((platformHost) => clean.endsWith(`.${platformHost}`))) {
+    return null;
+  }
+
+  // Production custom domain: `<subdomain>.<domain>.<tld>` (3+ labels)
+  const parts = clean.split('.');
+  return parts.length >= 3 && parts[0] !== 'www' ? parts[0] : null;
+}
+
 export function middleware(request: NextRequest) {
-  const hostname = (request.headers.get('host') || '').split(':')[0];
+  const hostname = request.headers.get('host') || '';
   const url = request.nextUrl.clone();
 
-  // Extract subdomain
-  const parts = hostname.split('.');
-  const subdomain = parts.length > 1 ? parts[0] : null;
+  const subdomain = extractSubdomain(hostname);
 
-  // Handle localhost subdomains - simplified logic
-  if (hostname.includes('localhost') && subdomain && subdomain !== 'www') {
-    // Add tenant query parameter for client-side detection
+  if (subdomain) {
+    // Add tenant query parameter for client-side/SSR detection
     url.searchParams.set('tenant', subdomain);
 
     // For root path, redirect to dashboard
