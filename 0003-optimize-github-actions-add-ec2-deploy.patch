diff --git a/.github/workflows/deploy-ec2.yml b/.github/workflows/deploy-ec2.yml
new file mode 100644
index 0000000..98f3613
--- /dev/null
+++ b/.github/workflows/deploy-ec2.yml
@@ -0,0 +1,103 @@
+# LuxGen — Deploy to the AWS free-tier EC2 box
+# Docs: docs/deployment/GITHUB_ACTIONS_OIDC_SETUP.md (one-time AWS console setup)
+#
+# Zero stored AWS credentials: this workflow authenticates via GitHub's OIDC
+# provider (aws-actions/configure-aws-credentials), assumes a short-lived,
+# least-privilege IAM role, and pushes the deploy command through SSM
+# Send-Command — no SSH key, no long-lived access key sitting in repo secrets.
+#
+# Runs only after CI has gone green on main (workflow_run), or manually via
+# workflow_dispatch for a redeploy without a new commit (e.g. after rotating
+# a Parameter Store value).
+
+name: Deploy to EC2 (free tier)
+
+on:
+  workflow_run:
+    workflows: [CI]
+    branches: [main]
+    types: [completed]
+  workflow_dispatch: {}
+
+permissions:
+  id-token: write # required for OIDC — do not add contents:write, not needed
+  contents: read
+
+concurrency:
+  group: deploy-ec2-production
+  cancel-in-progress: false # never cancel a deploy mid-flight
+
+jobs:
+  deploy:
+    name: Deploy via SSM
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    environment: production
+    if: >
+      github.event_name == 'workflow_dispatch' ||
+      github.event.workflow_run.conclusion == 'success'
+    steps:
+      - name: Configure AWS credentials (OIDC, no stored keys)
+        uses: aws-actions/configure-aws-credentials@v4
+        with:
+          role-to-assume: ${{ vars.AWS_DEPLOY_ROLE_ARN }}
+          aws-region: ${{ vars.AWS_REGION || 'us-east-1' }}
+          role-session-name: gha-luxgen-deploy
+
+      - name: Resolve target instance
+        id: instance
+        run: |
+          INSTANCE_ID=$(aws ec2 describe-instances \
+            --filters "Name=tag:Name,Values=${{ vars.EC2_INSTANCE_TAG || 'luxgen-prod' }}" \
+                      "Name=instance-state-name,Values=running" \
+            --query "Reservations[0].Instances[0].InstanceId" \
+            --output text)
+          if [ "$INSTANCE_ID" = "None" ] || [ -z "$INSTANCE_ID" ]; then
+            echo "::error::No running EC2 instance tagged Name=${{ vars.EC2_INSTANCE_TAG || 'luxgen-prod' }} found."
+            exit 1
+          fi
+          echo "instance_id=$INSTANCE_ID" >> "$GITHUB_OUTPUT"
+
+      - name: Send deploy command over SSM
+        id: send
+        run: |
+          COMMAND_ID=$(aws ssm send-command \
+            --instance-ids "${{ steps.instance.outputs.instance_id }}" \
+            --document-name "AWS-RunShellScript" \
+            --comment "gha-deploy ${{ github.sha }}" \
+            --parameters commands='[
+              "set -euo pipefail",
+              "cd /opt/luxgen",
+              "git fetch origin main",
+              "git reset --hard origin/main",
+              "aws ssm get-parameters-by-path --path /luxgen/prod/ --with-decryption --query \"Parameters[*].[Name,Value]\" --output text | sed \"s#/luxgen/prod/##\" | awk \"{print \\$1\\\"=\\\"\\$2}\" > .env",
+              "docker compose -f docker-compose.yml -f docker-compose.prod.yml pull",
+              "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build mongodb redis api web nginx",
+              "docker image prune -af --filter until=48h"
+            ]' \
+            --query "Command.CommandId" \
+            --output text)
+          echo "command_id=$COMMAND_ID" >> "$GITHUB_OUTPUT"
+
+      - name: Wait for deploy to finish
+        run: |
+          aws ssm wait command-executed \
+            --command-id "${{ steps.send.outputs.command_id }}" \
+            --instance-id "${{ steps.instance.outputs.instance_id }}" \
+          || true
+          STATUS=$(aws ssm get-command-invocation \
+            --command-id "${{ steps.send.outputs.command_id }}" \
+            --instance-id "${{ steps.instance.outputs.instance_id }}" \
+            --query "Status" --output text)
+          echo "Deploy status: $STATUS"
+          aws ssm get-command-invocation \
+            --command-id "${{ steps.send.outputs.command_id }}" \
+            --instance-id "${{ steps.instance.outputs.instance_id }}" \
+            --query "StandardOutputContent" --output text
+          if [ "$STATUS" != "Success" ]; then
+            aws ssm get-command-invocation \
+              --command-id "${{ steps.send.outputs.command_id }}" \
+              --instance-id "${{ steps.instance.outputs.instance_id }}" \
+              --query "StandardErrorContent" --output text
+            exit 1
+          fi
